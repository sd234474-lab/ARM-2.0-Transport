# Copy OUTSIDE the checkout to ~/.config/arm2-r2-uat.env, chmod 0600.
# Placeholders intentionally fail preflight. Do not use source/export; --env-file only.
# secrets.token_hex(32) for each password/key independently; never reuse B1 secrets.
R2_DB_PASSWORD=GENERATE_64_HEX_CHARACTERS
ARM2_TABLE_SIGNING_KEY=GENERATE_ANOTHER_64_HEX_CHARACTERS
R2_SOURCE_SHA=SET_REVIEWED_40_CHARACTER_CHECKOUT_SHA
# No default port: read-only availability check on Ubuntu is mandatory.
R2_HTTP_PORT=SELECT_UNUSED_PORT
APP_ORIGIN=http://127.0.0.1:SELECT_UNUSED_PORT
APP_ENV=test
ORGANIZATIONS_ENABLED=false
DATA_DIR=/data
COOKIE_SECURE=false
MAX_BOT_TOKEN=
YANDEX_DISK_TOKEN=
YANDEX_MAPS_API_KEY=
